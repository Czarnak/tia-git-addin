<UserControl x:Class="TiaGitAddIn.UI.Views.Comparison.ComparisonPresentationHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:TiaGitAddIn.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="500"
             d:DesignWidth="900">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ComparisonTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: mode/support-level summary shared by every presentation kind. -->
        <TextBlock Grid.Row="0"
                   Text="{Binding Header}"
                   FontWeight="Bold"
                   FontSize="14"
                   Margin="8,8,8,4"/>

        <!-- Limitation panel: hidden only for Full support; every other level explains its narrowing. -->
        <Border x:Name="LimitationPanel"
                Grid.Row="1"
                Background="#FFF3CD"
                BorderBrush="#FFEEBA"
                BorderThickness="1"
                Margin="8,0,8,4"
                Padding="8,4"
                Visibility="{Binding HasLimitation, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding Limitation}"
                       TextWrapping="Wrap"
                       Foreground="#856404"/>
        </Border>

        <!-- Diagnostics: expandable, hidden entirely when there are none. -->
        <Expander x:Name="DiagnosticsExpander"
                  Grid.Row="2"
                  Header="Diagnostics"
                  Margin="8,0,8,4"
                  IsExpanded="False">
            <Expander.Style>
                <Style TargetType="Expander">
                    <Setter Property="Visibility"
                            Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Metadata.Diagnostics.Count}"
                                     Value="0">
                            <Setter Property="Visibility"
                                    Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Expander.Style>
            <ItemsControl ItemsSource="{Binding Metadata.Diagnostics}"
                          Margin="4">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal"
                                    Margin="2">
                            <TextBlock Text="{Binding Severity}"
                                       FontWeight="Bold"
                                       Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Code}"
                                       Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Message}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding LocationLabel}"
                                       Foreground="Gray"
                                       Margin="6,0,0,0"
                                       Visibility="{Binding HasLocation, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Expander>

        <!-- Semantic content: TabControl with the dedicated presentation view plus an optional raw-text tab. -->
        <TabControl Grid.Row="3"
                    Margin="4,0,4,4">
            <TabItem Header="Comparison">
                <ContentControl Content="{Binding}"/>
            </TabItem>
            <TabItem x:Name="RawTextTab"
                     Header="Raw text"
                     Visibility="{Binding HasRawText, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Left"
                                   FontWeight="Bold"
                                   Margin="4,4,4,2"/>
                        <TextBox Text="{Binding Metadata.RawText.LeftText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 TextWrapping="NoWrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"/>
                    </DockPanel>

                    <Rectangle Grid.Column="1"
                               Fill="#DDDDDD"/>

                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Right"
                                   FontWeight="Bold"
                                   Margin="4,4,4,2"/>
                        <TextBox Text="{Binding Metadata.RawText.RightText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 TextWrapping="NoWrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"/>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
