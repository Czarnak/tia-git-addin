<UserControl x:Class="TiaGitAddIn.UI.Views.Comparison.TextDiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:TiaGitAddIn.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="700">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="LineRowStyle"
               TargetType="Grid">
            <Style.Triggers>
                <!-- Bound against the already-stringified StatusLabel (not the Kind enum) so the
                     comparison is a plain string match, not an enum/string conversion. -->
                <DataTrigger Binding="{Binding StatusLabel}"
                             Value="+">
                    <Setter Property="Background"
                            Value="#DDFFDD"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusLabel}"
                             Value="−">
                    <Setter Property="Background"
                            Value="#FFDDDD"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusLabel}"
                             Value="…">
                    <Setter Property="Background"
                            Value="#EFEFEF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FFF3CD"
                BorderBrush="#FFEEBA"
                BorderThickness="0,0,0,1"
                Padding="6,3"
                Visibility="{Binding IsTruncated, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Diff truncated: this comparison exceeded the configured size limits."
                       FontSize="11"
                       Foreground="#856404"/>
        </Border>

        <ListView Grid.Row="1"
                  x:Name="LinesListView"
                  BorderThickness="0"
                  ItemsSource="{Binding Lines}"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Item">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Style="{StaticResource LineRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding StatusLabel}"
                                   FontFamily="Consolas"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding LeftLineNumber}"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="#999999"
                                   HorizontalAlignment="Right"
                                   Padding="0,0,6,0"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding RightLineNumber}"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="#999999"
                                   HorizontalAlignment="Right"
                                   Padding="0,0,6,0"/>
                        <TextBlock Grid.Column="3"
                                   Text="{Binding Text}"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   TextWrapping="NoWrap"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding"
                            Value="0"/>
                    <Setter Property="HorizontalContentAlignment"
                            Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</UserControl>
