<UserControl x:Class="TiaGitAddIn.UI.Views.Comparison.InterfaceDiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:TiaGitAddIn.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="700">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="StatusLabelStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="10"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Padding"
                    Value="4,1"/>
            <Setter Property="Margin"
                    Value="0,0,6,0"/>
            <Setter Property="Foreground"
                    Value="#3B3B3B"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusLabel}"
                             Value="Added">
                    <Setter Property="Background"
                            Value="#C8FFC8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusLabel}"
                             Value="Removed">
                    <Setter Property="Background"
                            Value="#FFC8C8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusLabel}"
                             Value="Modified">
                    <Setter Property="Background"
                            Value="#FFFFC8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusLabel}"
                             Value="Unchanged">
                    <Setter Property="Visibility"
                            Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Field-level changes (nested list shown only when a row has any). -->
        <DataTemplate x:Key="FieldChangeTemplate">
            <Grid Margin="20,1,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}"
                           FontStyle="Italic"
                           FontSize="11"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding LeftValue}"
                           FontSize="11"
                           Foreground="#8A2020"/>
                <TextBlock Grid.Column="2"
                           Text=" -> "
                           FontSize="11"/>
                <TextBlock Grid.Column="3"
                           Text="{Binding RightValue}"
                           FontSize="11"
                           Foreground="#1F6F1F"/>
            </Grid>
        </DataTemplate>

        <!-- Recursive member row: name/status/datatype/default value plus nested children and field changes. -->
        <HierarchicalDataTemplate x:Key="MemberRowTemplate"
                                  ItemsSource="{Binding Children}">
            <StackPanel>
                <Grid MinHeight="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusLabel}"
                               Style="{StaticResource StatusLabelStyle}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2"
                               Text="{Binding LeftDatatype}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3"
                               Text="{Binding RightDatatype}"
                               VerticalAlignment="Center"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding FieldChanges}"
                              ItemTemplate="{StaticResource FieldChangeTemplate}"
                              Visibility="{Binding HasFieldChanges, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate x:Key="SectionRowTemplate"
                                  ItemsSource="{Binding Members}"
                                  ItemTemplate="{StaticResource MemberRowTemplate}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Name}"
                           FontWeight="Bold"/>
                <TextBlock Text="{Binding StatusLabel}"
                           Style="{StaticResource StatusLabelStyle}"/>
            </StackPanel>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Background="#E7E7E7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Name"
                       FontWeight="Bold"
                       Padding="4,2"/>
            <TextBlock Grid.Column="1"
                       Text="Status"
                       FontWeight="Bold"
                       Padding="4,2"/>
            <TextBlock Grid.Column="2"
                       Text="Left type"
                       FontWeight="Bold"
                       Padding="4,2"/>
            <TextBlock Grid.Column="3"
                       Text="Right type"
                       FontWeight="Bold"
                       Padding="4,2"/>
        </Grid>

        <TreeView Grid.Row="1"
                  x:Name="SectionsTreeView"
                  BorderThickness="0"
                  ItemsSource="{Binding Sections}"
                  ItemTemplate="{StaticResource SectionRowTemplate}"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded"
                            Value="True"/>
                </Style>
            </TreeView.ItemContainerStyle>
        </TreeView>
    </Grid>
</UserControl>
