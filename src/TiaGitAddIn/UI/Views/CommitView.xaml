<UserControl x:Class="TiaGitAddIn.UI.Views.CommitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TiaGitAddIn.UI.Views"
             xmlns:vm="clr-namespace:TiaGitAddIn.UI.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Content="Commit Message:" Grid.Row="0" FontWeight="Bold"/>
        
        <TextBox Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}" 
                 AcceptsReturn="True" 
                 TextWrapping="Wrap" 
                 SpellCheck.IsEnabled="True"
                 VerticalScrollBarVisibility="Auto"
                 Grid.Row="1" Margin="0,5"/>

        <DockPanel Grid.Row="2" Margin="0,5">
            <TextBlock Text="{Binding ValidationMessage}" Foreground="Red" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding CommitMessage.Length, StringFormat='Characters: {0}'}" 
                       HorizontalAlignment="Right" Foreground="Gray" VerticalAlignment="Center"/>
        </DockPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock Text="{Binding LastOperationMessage}" Foreground="DimGray" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button Content="Commit" Command="{Binding CommitCommand}" Padding="30,5" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</UserControl>
