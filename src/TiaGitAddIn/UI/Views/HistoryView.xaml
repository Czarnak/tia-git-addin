<UserControl x:Class="TiaGitAddIn.UI.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600"
        d:DesignWidth="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"
                    MinHeight="120"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Commit log -->
        <ListView Grid.Row="0"
                  ItemsSource="{Binding Commits}"
                  SelectedItem="{Binding SelectedCommit}"
                  SelectionMode="Single"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Hash"
                            Width="75">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Hash}"
                                           FontFamily="Consolas"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Hash}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Author"
                            Width="140"
                            DisplayMemberBinding="{Binding AuthorName}"/>
                    <GridViewColumn Header="Date"
                            Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding AuthorDate, StringFormat=\{0:yyyy-MM-dd HH:mm\}}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Message"
                            Width="450"
                            DisplayMemberBinding="{Binding Subject}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <GridSplitter Grid.Row="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="#DDDDDD"/>

        <!-- Detail panel -->
        <Grid Grid.Row="2"
                Margin="5,3,5,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- Commit metadata + message -->
            <Border Grid.Column="0"
                    BorderThickness="1"
                    BorderBrush="#CCCCCC"
                    Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Hash:"
                            FontWeight="Bold"
                               Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,10,4"
                            VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedCommit.Hash}"
                               Grid.Row="0"
                            Grid.Column="1"
                            FontFamily="Consolas"
                               Margin="0,0,0,4"
                            VerticalAlignment="Center"/>

                    <TextBlock Text="Author:"
                            FontWeight="Bold"
                               Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,0,10,4"
                            VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedCommit.AuthorName}"
                               Grid.Row="1"
                            Grid.Column="1"
                               Margin="0,0,0,4"
                            VerticalAlignment="Center"/>

                    <TextBlock Text="Date:"
                            FontWeight="Bold"
                               Grid.Row="2"
                            Grid.Column="0"
                            Margin="0,0,10,4"
                            VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedCommit.AuthorDate, StringFormat=\{0:yyyy-MM-dd HH:mm:ss zzz\}}"
                               Grid.Row="2"
                            Grid.Column="1"
                               Margin="0,0,0,4"
                            VerticalAlignment="Center"/>

                    <ScrollViewer Grid.Row="3"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                                  VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                                  Margin="0,8,0,0">
                        <TextBlock Text="{Binding SelectedCommit.Subject}"
                                   TextWrapping="Wrap"
                                FontSize="13"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                    Width="5"
                    HorizontalAlignment="Stretch"
                    Background="#DDDDDD"/>

            <!-- Changed files -->
            <Border Grid.Column="2"
                    BorderThickness="1"
                    BorderBrush="#CCCCCC">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Background="#F5F5F5"
                            BorderBrush="#CCCCCC"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="Changed Files"
                                   FontWeight="Bold"
                                   Padding="8,5,8,5"/>
                    </Border>
                    <ListBox ItemsSource="{Binding ChangedFiles}"
                            BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                        FontFamily="Consolas"
                                        FontSize="11"
                                           ToolTip="{Binding}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Status bar -->
        <StatusBar Grid.Row="3"
                Background="Transparent"
                   BorderThickness="0,1,0,0"
                BorderBrush="#DDD">
            <StatusBarItem>
                <TextBlock Text="{Binding LastOperationMessage}"
                        Foreground="DimGray"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <Button Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Padding="10,2"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
