<UserControl x:Class="TiaGitAddIn.UI.Views.StatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TiaGitAddIn.UI.Views"
             xmlns:vm="clr-namespace:TiaGitAddIn.UI.ViewModels"
             xmlns:conv="clr-namespace:TiaGitAddIn.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="450"
        d:DesignWidth="800">
    <UserControl.Resources>
        <conv:FileStatusToColorConverter x:Key="StatusToColor"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="FileListStyle"
                TargetType="ListView">
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Margin"
                    Value="0,5"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                Margin="0,0,0,10">
            <TextBlock Text="{Binding CurrentBranch, StringFormat='Branch: {0}'}"
                    FontWeight="Bold"
                    FontSize="14"/>
            <TextBlock Text="{Binding TrackingSummary}"
                    Foreground="Gray"
                    Visibility="{Binding TrackingSummary, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <Expander Header="Staged Changes"
                        IsExpanded="True">
                    <ListView ItemsSource="{Binding StagedEntries}"
                            Style="{StaticResource FileListStyle}"
                            x:Name="StagedList">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding StatusText}"
                                            Foreground="{Binding Status, Converter={StaticResource StatusToColor}}"
                                            FontWeight="Bold"
                                            Width="60"
                                            Grid.Column="0"/>
                                    <TextBlock Text="{Binding FilePath}"
                                            Grid.Column="1"
                                            Margin="5,0"/>
                                    <Button Content="Unstage"
                                            Command="{Binding DataContext.UnstageSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Grid.Column="2"
                                            Padding="5,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Expander>

                <Expander Header="Unstaged Changes"
                        IsExpanded="True"
                        Margin="0,10,0,0">
                    <ListView ItemsSource="{Binding UnstagedEntries}"
                            Style="{StaticResource FileListStyle}"
                            x:Name="UnstagedList">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding StatusText}"
                                            Foreground="{Binding Status, Converter={StaticResource StatusToColor}}"
                                            FontWeight="Bold"
                                            Width="60"
                                            Grid.Column="0"/>
                                    <TextBlock Text="{Binding FilePath}"
                                            Grid.Column="1"
                                            Margin="5,0"/>
                                    <Button Content="Stage"
                                            Command="{Binding DataContext.StageSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Grid.Column="2"
                                            Padding="5,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Expander>

                <Expander Header="Untracked Files"
                        IsExpanded="True"
                        Margin="0,10,0,0">
                    <ListView ItemsSource="{Binding UntrackedEntries}"
                            Style="{StaticResource FileListStyle}"
                            x:Name="UntrackedList">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Untracked"
                                            Foreground="Gray"
                                            FontWeight="Bold"
                                            Width="60"
                                            Grid.Column="0"/>
                                    <TextBlock Text="{Binding FilePath}"
                                            Grid.Column="1"
                                            Margin="5,0"/>
                                    <Button Content="Stage"
                                            Command="{Binding DataContext.StageSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Grid.Column="2"
                                            Padding="5,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <StatusBar Grid.Row="2"
                Background="Transparent"
                BorderThickness="0,1,0,0"
                BorderBrush="#DDD">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusSummary}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding LastOperationMessage}"
                            Margin="0,0,10,0"
                            Foreground="DimGray"/>
                    <Button Content="Stage All"
                            Command="{Binding StageAllCommand}"
                            Padding="10,0"/>
                    <Button Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            Margin="5,0,0,0"
                            Padding="10,0"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
