<UserControl x:Class="TiaGitAddIn.UI.Views.DiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:comparison="clr-namespace:TiaGitAddIn.UI.Views.Comparison"
             xmlns:conv="clr-namespace:TiaGitAddIn.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="1000">
    <UserControl.Resources>
        <conv:DiffLineTypeToColorConverter x:Key="LineTypeToBackground"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main content -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"
                                  MinWidth="150"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- File list panel -->
            <DockPanel Grid.Column="0">
                <ListBox ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding SelectedEntry}"
                         SelectionMode="Single"
                         SelectionChanged="OnSelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Change type badge -->
                                <Border Grid.Column="0"
                                        CornerRadius="2"
                                        Padding="2,0"
                                        Background="{Binding ChangeType, Converter={StaticResource LineTypeToBackground}}">
                                    <TextBlock Text="{Binding ChangeType}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                </Border>

                                <!-- File name -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding FileName}"
                                           ToolTip="{Binding FilePath}"
                                           Margin="5,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="#DDDDDD"/>

            <!-- Diff content panel: every artifact kind (text, LAD, interface-only, unsupported, error)
                 renders through the one ComparisonPresentationHost, driven entirely by CurrentPresentation. -->
            <comparison:ComparisonPresentationHost Grid.Column="2"
                                                    DataContext="{Binding CurrentPresentation}"/>
        </Grid>

        <!-- Status bar -->
        <StatusBar Grid.Row="1"
                   Background="Transparent"
                   BorderThickness="0,1,0,0"
                   BorderBrush="#DDD">
            <StatusBarItem>
                <TextBlock Text="{Binding LastOperationMessage}"
                           Foreground="DimGray"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
