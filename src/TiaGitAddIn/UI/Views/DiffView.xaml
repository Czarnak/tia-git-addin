<UserControl x:Class="TiaGitAddIn.UI.Views.DiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TiaGitAddIn.UI.Views"
             xmlns:conv="clr-namespace:TiaGitAddIn.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="1000">
    <UserControl.Resources>
        <conv:DiffLineTypeToColorConverter x:Key="LineTypeToBackground"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main content -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"
                                  MinWidth="150"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- File list panel -->
            <DockPanel Grid.Column="0">
                <ListBox ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding SelectedEntry}"
                         SelectionMode="Single"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Change type badge -->
                                <Border Grid.Column="0"
                                        CornerRadius="2"
                                        Padding="2,0"
                                        Background="{Binding ChangeType, Converter={StaticResource LineTypeToBackground}}">
                                    <TextBlock Text="{Binding ChangeType}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                </Border>

                                <!-- File name -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding FileName}"
                                           ToolTip="{Binding FilePath}"
                                           Margin="5,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>

                                <!-- TIA artifact indicator -->
                                <Border Grid.Column="2"
                                        Background="#F57F17"
                                        CornerRadius="2"
                                        Padding="3,1"
                                        Visibility="{Binding IsTiaArtifact, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="TIA"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="White"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="#DDDDDD"/>

            <!-- Diff content panel -->
            <DockPanel Grid.Column="2">

                <!-- TIA heuristic summary bar -->
                <Border DockPanel.Dock="Top"
                        Background="#FFFDE7"
                        BorderBrush="#F9A825"
                        BorderThickness="0,0,0,1"
                        Padding="10,6"
                        Visibility="{Binding SelectedEntry.IsTiaArtifact, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left">
                            <TextBlock Text="TIA Artifact"
                                       FontWeight="Bold"
                                       Foreground="#E65100"
                                       Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding SelectedEntry.TiaSummary}"
                                       Foreground="#6D4C41"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <ToggleButton Content="Visual View"
                                          IsChecked="{Binding ShowVisualDiff}"
                                          Padding="8,2"
                                          Margin="5,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Content Area -->
                <Grid>
                    <!-- Text Diff View -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility"
                                        Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowVisualDiff}"
                                                 Value="True">
                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <ItemsControl ItemsSource="{Binding DisplayedLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="{Binding LineType, Converter={StaticResource LineTypeToBackground}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Old line number -->
                                        <Border Grid.Column="0"
                                                BorderBrush="#DDDDDD"
                                                BorderThickness="0,0,1,0">
                                            <TextBlock Text="{Binding OldLineNumberText}"
                                                       FontFamily="Consolas"
                                                       FontSize="11"
                                                       Foreground="#999999"
                                                       HorizontalAlignment="Right"
                                                       Padding="0,1,6,1"/>
                                        </Border>

                                        <!-- New line number -->
                                        <Border Grid.Column="1"
                                                BorderBrush="#DDDDDD"
                                                BorderThickness="0,0,1,0">
                                            <TextBlock Text="{Binding NewLineNumberText}"
                                                       FontFamily="Consolas"
                                                       FontSize="11"
                                                       Foreground="#999999"
                                                       HorizontalAlignment="Right"
                                                       Padding="0,1,6,1"/>
                                        </Border>

                                        <!-- Line content -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Content}"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   Padding="6,1"
                                                   TextWrapping="NoWrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Graphical Diff View -->
                    <local:LadDiffView DataContext="{Binding LadDiff}">
                        <local:LadDiffView.Style>
                            <Style TargetType="local:LadDiffView">
                                <Setter Property="Visibility"
                                        Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.ShowVisualDiff, RelativeSource={RelativeSource AncestorType={x:Type local:DiffView}}}"
                                                 Value="True">
                                        <Setter Property="Visibility"
                                                Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </local:LadDiffView.Style>
                    </local:LadDiffView>
                </Grid>
            </DockPanel>
        </Grid>

        <!-- Status bar -->
        <StatusBar Grid.Row="1"
                   Background="Transparent"
                   BorderThickness="0,1,0,0"
                   BorderBrush="#DDD">
            <StatusBarItem>
                <TextBlock Text="{Binding LastOperationMessage}"
                           Foreground="DimGray"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
