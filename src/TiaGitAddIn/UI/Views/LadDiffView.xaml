<UserControl x:Class="TiaGitAddIn.UI.Views.LadDiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TiaGitAddIn.UI.Views"
             xmlns:converters="clr-namespace:TiaGitAddIn.UI.Converters"
             xmlns:viewmodels="clr-namespace:TiaGitAddIn.UI.ViewModels"
             xmlns:models="clr-namespace:TiaGitAddIn.Models.Lad"
             mc:Ignorable="d"
             d:DesignHeight="450"
        d:DesignWidth="800">
    <UserControl.Resources>
        <converters:CompareStateToColorConverter x:Key="CompareStateToColorConverter"/>
        <converters:BoolToVisibilityConverter x:Key="LadBoolToVis"/>

        <!-- Shape for Ladder Elements -->
        <DataTemplate DataType="{x:Type viewmodels:LadElementViewModel}">
            <Grid Width="{Binding Width}" Height="{Binding Height}">
                <!-- Background highlight for diff state -->
                <Border Background="{Binding DiffState, Converter={StaticResource CompareStateToColorConverter}}" 
                        Opacity="0.3" CornerRadius="2"/>
                
                <!-- Element Graphic -->
                <ContentControl VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <!-- Default: Box -->
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate>
                                        <Border BorderBrush="Black" BorderThickness="1" Background="White" MinWidth="80" MinHeight="50">
                                            <StackPanel>
                                                <Border Background="#E0E0E0" Padding="2">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding Operand}" FontSize="9" Margin="4" TextAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            
                            <Style.Triggers>
                                <!-- Powerrail -->
                                <DataTrigger Binding="{Binding ElementType}" Value="{x:Static models:LadElementType.Powerrail}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <Rectangle Width="4" Fill="Black" Height="80"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>

                                <!-- Contact -->
                                <DataTrigger Binding="{Binding ElementType}" Value="{x:Static models:LadElementType.Contact}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <Canvas Width="40" Height="30">
                                                    <Line X1="0" Y1="15" X2="15" Y2="15" Stroke="Black" StrokeThickness="1"/>
                                                    <Line X1="15" Y1="5" X2="15" Y2="25" Stroke="Black" StrokeThickness="2"/>
                                                    <Line X1="25" Y1="5" X2="25" Y2="25" Stroke="Black" StrokeThickness="2"/>
                                                    <Line X1="25" Y1="15" X2="40" Y2="15" Stroke="Black" StrokeThickness="1"/>
                                                    <TextBlock Canvas.Top="-15" Canvas.Left="0" Width="40" Text="{Binding DataContext.Operand, RelativeSource={RelativeSource AncestorType=ContentControl}}" FontSize="9" TextAlignment="Center"/>
                                                </Canvas>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>

                                <!-- Negated Contact -->
                                <DataTrigger Binding="{Binding ElementType}" Value="{x:Static models:LadElementType.NegatedContact}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <Canvas Width="40" Height="30">
                                                    <Line X1="0" Y1="15" X2="15" Y2="15" Stroke="Black" StrokeThickness="1"/>
                                                    <Line X1="15" Y1="5" X2="15" Y2="25" Stroke="Black" StrokeThickness="2"/>
                                                    <Line X1="25" Y1="5" X2="25" Y2="25" Stroke="Black" StrokeThickness="2"/>
                                                    <Line X1="25" Y1="15" X2="40" Y2="15" Stroke="Black" StrokeThickness="1"/>
                                                    <Line X1="12" Y1="25" X2="28" Y2="5" Stroke="Black" StrokeThickness="1"/>
                                                    <TextBlock Canvas.Top="-15" Canvas.Left="0" Width="40" Text="{Binding DataContext.Operand, RelativeSource={RelativeSource AncestorType=ContentControl}}" FontSize="9" TextAlignment="Center"/>
                                                </Canvas>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>

                                <!-- Coil -->
                                <DataTrigger Binding="{Binding ElementType}" Value="{x:Static models:LadElementType.Coil}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <Canvas Width="40" Height="30">
                                                    <Line X1="0" Y1="15" X2="12" Y2="15" Stroke="Black" StrokeThickness="1"/>
                                                    <Path Data="M 12,15 A 8,8 0 1 1 12.1,15" Stroke="Black" StrokeThickness="1" Fill="Transparent"/>
                                                    <Line X1="28" Y1="15" X2="40" Y2="15" Stroke="Black" StrokeThickness="1"/>
                                                    <TextBlock Canvas.Top="-15" Canvas.Left="0" Width="40" Text="{Binding DataContext.Operand, RelativeSource={RelativeSource AncestorType=ContentControl}}" FontSize="9" TextAlignment="Center"/>
                                                </Canvas>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                
                                <!-- Or Branch -->
                                <DataTrigger Binding="{Binding ElementType}" Value="{x:Static models:LadElementType.OrBranch}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <Ellipse Width="6" Height="6" Fill="Black" Margin="-3,-3,0,0"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Grid>
        </DataTemplate>

        <!-- Template for a single LAD network side -->
        <DataTemplate x:Key="NetworkTemplate" DataType="{x:Type viewmodels:LadNetworkViewModel}">
            <Canvas Width="{Binding CanvasWidth}"
                    Height="{Binding CanvasHeight}"
                    Margin="10"
                    Background="Transparent">
                
                <!-- Elements layer -->
                <ItemsControl ItemsSource="{Binding Elements}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>

                <!-- Wires layer -->
                <ItemsControl ItemsSource="{Binding Wires}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Line X1="{Binding X1}"
                                    Y1="{Binding Y1}"
                                    X2="{Binding X2}"
                                    Y2="{Binding Y2}"
                                    Stroke="Black"
                                    StrokeThickness="1"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <!-- Center=(75, 50) -->
                            <Setter Property="Canvas.Left" Value="75"/>
                            <Setter Property="Canvas.Top" Value="50"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </Canvas>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Side-by-side header -->
                <Grid Margin="10,0,10,0" Background="#F8F8F8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="OLD (Parent)" FontWeight="Bold" Margin="5" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="NEW (Commit)" FontWeight="Bold" Margin="5" HorizontalAlignment="Center"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding Networks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewmodels:LadNetworkPairViewModel}">
                            <Border BorderBrush="#DDDDDD"
                                    BorderThickness="1"
                                    Margin="10">
                                <StackPanel>
                                    <Border Background="#EEEEEE" Padding="5">
                                        <TextBlock Text="{Binding NetworkNumber, StringFormat=Network {0}}" FontWeight="Bold"/>
                                    </Border>

                                    <Grid MinHeight="100">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left side (Old) -->
                                        <Border Grid.Column="0"
                                                Background="{Binding Left.DiffState, Converter={StaticResource CompareStateToColorConverter}}">
                                            <ContentControl Content="{Binding Left}" ContentTemplate="{StaticResource NetworkTemplate}"/>
                                        </Border>

                                        <!-- Divider Line -->
                                        <Rectangle Grid.Column="1" Fill="#DDDDDD" VerticalAlignment="Stretch"/>

                                        <!-- Right side (New) -->
                                        <Border Grid.Column="2"
                                                Background="{Binding Right.DiffState, Converter={StaticResource CompareStateToColorConverter}}">
                                            <ContentControl Content="{Binding Right}" ContentTemplate="{StaticResource NetworkTemplate}"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Border Grid.Row="0"
                Background="#80FFFFFF"
                Visibility="{Binding IsBusy, Converter={StaticResource LadBoolToVis}}">
            <TextBlock Text="{Binding BusyMessage}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"/>
        </Border>

        <!-- Error Bar -->
        <Border Grid.Row="1"
                Background="#FFF3CD"
                BorderBrush="#FFEEBA"
                BorderThickness="1"
                Margin="0,5,0,0"
                Padding="5">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility"
                            Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding LadDiffError}"
                                Value="">
                            <Setter Property="Visibility"
                                    Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LadDiffError}"
                                Value="{x:Null}">
                            <Setter Property="Visibility"
                                    Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding LadDiffError}"
                    Foreground="#856404"
                    TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
