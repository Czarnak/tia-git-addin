<UserControl x:Class="TiaGitAddIn.UI.Views.LadDiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TiaGitAddIn.UI.Views"
             xmlns:converters="clr-namespace:TiaGitAddIn.UI.Converters"
             xmlns:viewmodels="clr-namespace:TiaGitAddIn.UI.ViewModels"
             xmlns:models="clr-namespace:TiaGitAddIn.Models.Lad;assembly=TiaGitAddIn.Core"
             xmlns:comparison="clr-namespace:TiaGitAddIn.UI.Views.Comparison"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.Resources>
        <converters:CompareStateToColorConverter x:Key="CompareStateToColorConverter"/>
        <converters:BoolToVisibilityConverter x:Key="LadBoolToVis"/>

        <Style x:Key="LadBoxPinTextStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="10"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis"/>
            <Setter Property="Foreground"
                    Value="Black"/>
        </Style>

        <DataTemplate x:Key="LadInputPinRowTemplate">
            <Grid Height="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="76"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Operand}"
                           Style="{StaticResource LadBoxPinTextStyle}"
                           HorizontalAlignment="Right"
                           TextAlignment="Right"/>
                <Line Grid.Column="1"
                      Tag="PinConnectorLine"
                      X1="0"
                      Y1="12"
                      X2="18"
                      Y2="12"
                      Stroke="Black"
                      StrokeThickness="1"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding Name}"
                           Style="{StaticResource LadBoxPinTextStyle}"
                           FontWeight="SemiBold"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="LadOutputPinRowTemplate">
            <Grid Height="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}"
                           Style="{StaticResource LadBoxPinTextStyle}"
                           HorizontalAlignment="Right"
                           TextAlignment="Right"
                           FontWeight="SemiBold"/>
                <Line Grid.Column="1"
                      Tag="PinConnectorLine"
                      X1="0"
                      Y1="12"
                      X2="18"
                      Y2="12"
                      Stroke="Black"
                      StrokeThickness="1"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding Operand}"
                           Style="{StaticResource LadBoxPinTextStyle}"/>
            </Grid>
        </DataTemplate>

        <!-- Shape for Ladder Elements -->
        <DataTemplate DataType="{x:Type viewmodels:LadElementViewModel}">
            <Grid Width="{Binding Width}"
                  Height="{Binding Height}">
                <Border Background="{Binding DiffState, Converter={StaticResource CompareStateToColorConverter}}"
                        Padding="6"
                        CornerRadius="3"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <ContentControl Width="{Binding Width}"
                                Height="{Binding Height}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <!-- Default: Box -->
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate>
                                        <Border BorderBrush="Black"
                                                BorderThickness="1"
                                                Background="White"
                                                Width="{Binding Width}"
                                                Height="{Binding Height}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <Border Background="#E0E0E0"
                                                        Padding="2">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontWeight="Bold"
                                                               FontSize="10"
                                                               HorizontalAlignment="Center"/>
                                                </Border>
                                                <Grid Grid.Row="1"
                                                      Margin="6,4,6,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="166"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="120"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ItemsControl Grid.Column="0"
                                                                  ItemsSource="{Binding InputPinRows}"
                                                                  ItemTemplate="{StaticResource LadInputPinRowTemplate}"
                                                                  VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1"
                                                                Margin="8,0"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Operand}"
                                                                   FontSize="10"
                                                                   TextAlignment="Center"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Equation}"
                                                                   FontSize="10"
                                                                   TextAlignment="Center"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,4,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility"
                                                                            Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Equation}"
                                                                                     Value="">
                                                                            <Setter Property="Visibility"
                                                                                    Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Equation}"
                                                                                     Value="{x:Null}">
                                                                            <Setter Property="Visibility"
                                                                                    Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Comment}"
                                                                   FontSize="9"
                                                                   Foreground="#555555"
                                                                   TextAlignment="Center"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,4,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility"
                                                                            Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Comment}"
                                                                                     Value="">
                                                                            <Setter Property="Visibility"
                                                                                    Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Comment}"
                                                                                     Value="{x:Null}">
                                                                            <Setter Property="Visibility"
                                                                                    Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <ItemsControl Grid.Column="2"
                                                                  ItemsSource="{Binding OutputPinRows}"
                                                                  ItemTemplate="{StaticResource LadOutputPinRowTemplate}"
                                                                  VerticalAlignment="Center"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>

                            <Style.Triggers>
                                <!-- Powerrail -->
                                <DataTrigger Binding="{Binding ElementType}"
                                             Value="{x:Static models:LadElementType.Powerrail}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <Rectangle Width="4"
                                                           Fill="Black"
                                                           Height="80"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>

                                <!-- Contact -->
                                <DataTrigger Binding="{Binding ElementType}"
                                             Value="{x:Static models:LadElementType.Contact}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <Canvas Width="40"
                                                        Height="30">
                                                    <Line X1="0"
                                                          Y1="15"
                                                          X2="15"
                                                          Y2="15"
                                                          Stroke="Black"
                                                          StrokeThickness="1"/>
                                                    <Line X1="15"
                                                          Y1="5"
                                                          X2="15"
                                                          Y2="25"
                                                          Stroke="Black"
                                                          StrokeThickness="2"/>
                                                    <Line X1="25"
                                                          Y1="5"
                                                          X2="25"
                                                          Y2="25"
                                                          Stroke="Black"
                                                          StrokeThickness="2"/>
                                                    <Line X1="25"
                                                          Y1="15"
                                                          X2="40"
                                                          Y2="15"
                                                          Stroke="Black"
                                                          StrokeThickness="1"/>
                                                    <TextBlock Canvas.Top="-15"
                                                               Canvas.Left="0"
                                                               Width="40"
                                                               Text="{Binding DataContext.Operand, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                                               FontSize="9"
                                                               TextAlignment="Center"/>
                                                </Canvas>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>

                                <!-- Negated Contact -->
                                <DataTrigger Binding="{Binding ElementType}"
                                             Value="{x:Static models:LadElementType.NegatedContact}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <Canvas Width="40"
                                                        Height="30">
                                                    <Line X1="0"
                                                          Y1="15"
                                                          X2="15"
                                                          Y2="15"
                                                          Stroke="Black"
                                                          StrokeThickness="1"/>
                                                    <Line X1="15"
                                                          Y1="5"
                                                          X2="15"
                                                          Y2="25"
                                                          Stroke="Black"
                                                          StrokeThickness="2"/>
                                                    <Line X1="25"
                                                          Y1="5"
                                                          X2="25"
                                                          Y2="25"
                                                          Stroke="Black"
                                                          StrokeThickness="2"/>
                                                    <Line X1="25"
                                                          Y1="15"
                                                          X2="40"
                                                          Y2="15"
                                                          Stroke="Black"
                                                          StrokeThickness="1"/>
                                                    <Line X1="12"
                                                          Y1="25"
                                                          X2="28"
                                                          Y2="5"
                                                          Stroke="Black"
                                                          StrokeThickness="1"/>
                                                    <TextBlock Canvas.Top="-15"
                                                               Canvas.Left="0"
                                                               Width="40"
                                                               Text="{Binding DataContext.Operand, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                                               FontSize="9"
                                                               TextAlignment="Center"/>
                                                </Canvas>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>

                                <!-- Coil -->
                                <DataTrigger Binding="{Binding ElementType}"
                                             Value="{x:Static models:LadElementType.Coil}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <Canvas Width="40"
                                                        Height="30">
                                                    <Line X1="0"
                                                          Y1="15"
                                                          X2="12"
                                                          Y2="15"
                                                          Stroke="Black"
                                                          StrokeThickness="1"/>
                                                    <Path Data="M 12,15 A 8,8 0 1 1 12.1,15"
                                                          Stroke="Black"
                                                          StrokeThickness="1"
                                                          Fill="Transparent"/>
                                                    <Line X1="28"
                                                          Y1="15"
                                                          X2="40"
                                                          Y2="15"
                                                          Stroke="Black"
                                                          StrokeThickness="1"/>
                                                    <TextBlock Canvas.Top="-15"
                                                               Canvas.Left="0"
                                                               Width="40"
                                                               Text="{Binding DataContext.Operand, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                                               FontSize="9"
                                                               TextAlignment="Center"/>
                                                </Canvas>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>

                                <!-- Or Branch -->
                                <DataTrigger Binding="{Binding ElementType}"
                                             Value="{x:Static models:LadElementType.OrBranch}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <Ellipse Width="6"
                                                         Height="6"
                                                         Fill="Black"
                                                         Margin="-3,-3,0,0"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Template for a single LAD network side -->
        <DataTemplate x:Key="NetworkTemplate"
                      DataType="{x:Type viewmodels:LadNetworkViewModel}">
            <Canvas Width="{Binding CanvasWidth}"
                    Height="{Binding CanvasHeight}"
                    Margin="10"
                    Background="Transparent">

                <!-- Wires layer -->
                <ItemsControl ItemsSource="{Binding Wires}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Line X1="{Binding X1}"
                                  Y1="{Binding Y1}"
                                  X2="{Binding X2}"
                                  Y2="{Binding Y2}"
                                  Stroke="Black"
                                  StrokeThickness="1"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <!-- Center=(75, 50) -->
                            <Setter Property="Canvas.Left"
                                    Value="75"/>
                            <Setter Property="Canvas.Top"
                                    Value="50"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>

                <!-- Elements layer -->
                <ItemsControl ItemsSource="{Binding Elements}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left"
                                    Value="{Binding X}"/>
                            <Setter Property="Canvas.Top"
                                    Value="{Binding Y}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </Canvas>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!--
                    Deep interface comparison (Task 8/9): renders InterfaceComparison, populated only
                    by LadDiffViewModel's result-only constructor. The legacy git/SACT-driven
                    constructor leaves InterfaceComparison null until Task 10 rewires DiffViewModel,
                    so this binds to nothing (and renders nothing) on that path; expected for one commit.
                -->
                <comparison:InterfaceDiffView DataContext="{Binding InterfaceComparison}"
                                               Margin="10"/>

                <!-- Side-by-side header -->
                <Grid Margin="10,0,10,0"
                      Background="#F8F8F8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="OLD (Parent)"
                               FontWeight="Bold"
                               Margin="5"
                               HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="NEW (Commit)"
                               FontWeight="Bold"
                               Margin="5"
                               HorizontalAlignment="Center"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding Networks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewmodels:LadNetworkPairViewModel}">
                            <Border BorderBrush="#DDDDDD"
                                    BorderThickness="1"
                                    Margin="10">
                                <StackPanel>
                                    <Border Background="#EEEEEE"
                                            Padding="5">
                                        <StackPanel>
                                            <TextBlock Text="{Binding NetworkNumber, StringFormat=Network {0}}"
                                                       FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="11"
                                                       Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility"
                                                                Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Title}"
                                                                         Value="">
                                                                <Setter Property="Visibility"
                                                                        Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Title}"
                                                                         Value="{x:Null}">
                                                                <Setter Property="Visibility"
                                                                        Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Comment}"
                                                       FontSize="10"
                                                       Foreground="#555555"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility"
                                                                Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Comment}"
                                                                         Value="">
                                                                <Setter Property="Visibility"
                                                                        Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Comment}"
                                                                         Value="{x:Null}">
                                                                <Setter Property="Visibility"
                                                                        Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <Grid MinHeight="100">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left side (Old) -->
                                        <Border Grid.Column="0"
                                                Background="Transparent">
                                            <ContentControl Content="{Binding Left}"
                                                            ContentTemplate="{StaticResource NetworkTemplate}"/>
                                        </Border>

                                        <!-- Divider Line -->
                                        <Rectangle Grid.Column="1"
                                                   Fill="#DDDDDD"
                                                   VerticalAlignment="Stretch"/>

                                        <!-- Right side (New) -->
                                        <Border Grid.Column="2"
                                                Background="Transparent">
                                            <ContentControl Content="{Binding Right}"
                                                            ContentTemplate="{StaticResource NetworkTemplate}"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Border Grid.Row="0"
                Background="#80FFFFFF"
                Visibility="{Binding IsBusy, Converter={StaticResource LadBoolToVis}}">
            <TextBlock Text="{Binding BusyMessage}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="16"
                       FontWeight="Bold"/>
        </Border>

        <!-- Error Bar -->
        <Border Grid.Row="1"
                Background="#FFF3CD"
                BorderBrush="#FFEEBA"
                BorderThickness="1"
                Margin="0,5,0,0"
                Padding="5">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility"
                            Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding LadDiffError}"
                                     Value="">
                            <Setter Property="Visibility"
                                    Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LadDiffError}"
                                     Value="{x:Null}">
                            <Setter Property="Visibility"
                                    Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding LadDiffError}"
                       Foreground="#856404"
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
